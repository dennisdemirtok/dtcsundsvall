---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ruler from '../components/Ruler.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Process from '../components/Process.astro';
import Referenser from '../components/Referenser.astro';
import AreaRot from '../components/AreaRot.astro';
---

<Base
  title="Byggfirma Sundsvall — tak, bygg & renovering | DTC Sundsvall AB"
  description="Lokal byggfirma i Sundsvall och Njurunda: takläggning, byggnation, renovering och snickeri med helhetsansvar och ROT-avdrag. Begär kostnadsfri offert."
  path="/"
>
  <Hero />
  <Ruler tone="dark" />
  <Services />
  <About />
  <Process />
  <Referenser />
  <AreaRot />
  <Ruler tone="light" />

  <section class="section section-alt cta-section">
    <div class="wrap cta-inner">
      <div>
        <span class="eyebrow">Kontakt</span>
        <h2>Dags att bygga något som håller?</h2>
        <p>
          Berätta om ditt projekt så återkommer vi med en kostnadsfri offert inom en
          arbetsdag — oavsett om det gäller ett helt takbyte eller några meter panel.
        </p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary" href="/kontakt/">Begär kostnadsfri offert</a>
        <a class="btn btn-dark" href="tel:+4660000000">Ring 060-00 00 00</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
  }

  .cta-inner p {
    color: var(--ink-soft);
    max-width: 52ch;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: stretch;
  }

  .cta-actions .btn {
    text-align: center;
  }

  @media (max-width: 860px) {
    .cta-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
