---
import Logo from './Logo.astro';

const links = [
  { href: '/tjanster/taklaggning/', label: 'Takläggning' },
  { href: '/tjanster/byggnation/', label: 'Byggnation' },
  { href: '/tjanster/renovering/', label: 'Renovering' },
  { href: '/tjanster/snickeri/', label: 'Snickeri' },
  { href: '/om-oss/', label: 'Om oss' },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/" aria-label="DTC Sundsvall AB — startsida">
      <Logo height={52} />
    </a>

    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      id="menu-btn"
    >
      <span class="menu-label">Meny</span>
      <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Huvudmeny">
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        <li><a class="nav-cta" href="/kontakt/">Begär offert</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--spruce);
    border-bottom: 1px solid var(--line-dark);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 68px;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    padding: 8px 0;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    font-size: 15px;
    font-weight: 500;
    color: rgba(247, 245, 240, .82);
    text-decoration: none;
    transition: color .15s ease;
  }

  .site-nav a:hover {
    color: var(--timber);
  }

  .nav-cta {
    display: inline-block;
    background: var(--timber);
    color: var(--spruce) !important;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: var(--radius);
    transition: background-color .15s ease;
  }

  .nav-cta:hover {
    background: var(--timber-deep);
    color: var(--paper) !important;
  }

  .menu-btn {
    display: none;
    align-items: center;
    gap: 9px;
    background: none;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    color: var(--paper);
    padding: 9px 14px;
    cursor: pointer;
  }

  .menu-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .menu-bars {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
  }

  .menu-bars span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--timber);
  }

  @media (max-width: 860px) {
    .menu-btn {
      display: inline-flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--spruce-2);
      border-bottom: 1px solid var(--line-dark);
      padding: 10px 22px 22px;
    }

    .site-nav.open {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-nav li a {
      display: block;
      padding: 13px 4px;
      font-size: 17px;
      border-bottom: 1px solid var(--line-dark);
    }

    .nav-cta {
      margin-top: 14px;
      text-align: center;
      border-bottom: none !important;
    }
  }
</style>

<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('site-nav');

  if (btn && nav) {
    const close = () => {
      nav.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    };

    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });

    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>
