---
import { Image } from 'astro:assets';
import { featuredProjects } from '../data/services';
---

<section class="section section-alt" id="referenser">
  <div class="wrap">
    <span class="eyebrow">Referenser</span>
    <h2>Utvalda projekt</h2>
    <p class="ref-lead">
      Ett urval av det vi byggt åt kunder i Sundsvallsområdet — från takbyten och
      verandor till kök, trädäck och inglasningar.
    </p>
    <div class="ref-grid">
      {featuredProjects.map((p) => (
        <figure class="ref-item">
          <div class="ref-media">
            <Image src={p.src} alt={p.alt} width={760} widths={[420, 760]} sizes="(max-width: 620px) 92vw, (max-width: 960px) 46vw, 370px" loading="lazy" />
          </div>
          <figcaption>
            <span class="dim-label">{p.label}</span>
            <strong>{p.title}</strong>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .ref-lead {
    max-width: 56ch;
    color: var(--ink-soft);
    margin-bottom: 40px;
  }

  .ref-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .ref-item {
    margin: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform .18s ease, box-shadow .18s ease;
  }

  .ref-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(21, 35, 27, .12);
  }

  .ref-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .ref-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  figcaption {
    padding: 16px 20px 18px;
    display: grid;
    gap: 3px;
  }

  figcaption strong {
    font-size: 15.5px;
  }

  @media (max-width: 960px) {
    .ref-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .ref-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
